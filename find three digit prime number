public class Main
{
    public static void main(String[] args) 
    {

        for (int n = 100; n <= 999; n++) 
        {
            int a = n / 100;
            int b = (n / 10) % 10;
            int c = n % 10;

            if ((a == 2 || a == 3 || a == 5 || a == 7) &&
                (b == 2 || b == 3 || b == 5 || b == 7) &&
                (c == 2 || c == 3 || c == 5 || c == 7)) {

                System.out.print(n + " ");
            }
        }
    }
}

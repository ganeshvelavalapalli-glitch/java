import java.util.*;
public class Main 
{
    public static void main(String[] args) 
    {
        Random r = new Random();
        int[] a = new int[5];
        for (int i = 0; i < 5; i++) {
            a[i] = r.nextInt(10) + 1;
        }
        Arrays.sort(a);
        System.out.println("Array elements:");
        for (int i = 0; i < 5; i++) 
        {
            System.out.print(a[i] + " ");
        }
    }
}
